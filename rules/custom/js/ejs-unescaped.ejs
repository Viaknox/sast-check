<html>
<body>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <h1><%- title %></h1>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div class="bio"><%- user.bio %></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <script>var data = <%- JSON.stringify(payload) %>;</script>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <p><%-comment.text-%></p>

  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- unsanitizedBio %></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- purifyUser %></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- escapeHtmlUser %></div>

  <!-- ok: sast.js.ejs-unescaped -->
  <%- include('partials/header') %>
  <!-- ok: sast.js.ejs-unescaped -->
  <%- include("partials/footer", { year: 2024 }) %>
  <!-- ok: sast.js.ejs-unescaped -->
  <h1><%= title %></h1>
  <!-- ok: sast.js.ejs-unescaped -->
  <main><%- body %></main>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%- sanitize(user.bio) %></div>
  <!-- ok: sast.js.ejs-unescaped -->
  <% items.forEach(function (i) { %><li><%= i %></li><% }) %>

  <% var logo = '<b>Acme</b>'; %>
  <% const tagline = "Fast <i>safe</i>"; %>
  <% let nav = include('partials/nav'); %>
  <% const foot = include("partials/foot"); %>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%- logo %></div>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%- tagline %></div>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%-nav%></div>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%- foot %></div>

  <% var greeting = "Hi " + user.name; %>
  <% var fromQuery = req.query.q; %>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- greeting %></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- fromQuery %></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- logo + user.bio %></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%-notDeclared%></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- unknownName -%></div>
</body>
</html>

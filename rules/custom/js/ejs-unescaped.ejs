  <!-- ruleid: sast.js.ejs-unescaped -->
  <p><%-comment.text-%></p>

  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- unsanitizedBio %></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- purifyUser %></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- escapeHtmlUser %></div>

  <!-- ok: sast.js.ejs-unescaped -->
  <%- include('partials/header') %>
  <!-- ok: sast.js.ejs-unescaped -->
  <%- include("partials/footer", { year: 2024 }) %>
  <!-- ok: sast.js.ejs-unescaped -->
  <h1><%= title %></h1>
  <!-- ok: sast.js.ejs-unescaped -->
  <main><%- body %></main>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%- sanitize(user.bio) %></div>
  <!-- ok: sast.js.ejs-unescaped -->
  <% items.forEach(function (i) { %><li><%= i %></li><% }) %>

  <% var logo = '<b>Acme</b>'; %>
  <% const tagline = "Fast <i>safe</i>"; %>
  <% let nav = include('partials/nav'); %>
  <% const foot = include("partials/foot"); %>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%- logo %></div>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%- tagline %></div>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%-nav%></div>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%- foot %></div>

  <% var greeting = "Hi " + user.name; %>
  <% var fromQuery = req.query.q; %>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- greeting %></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- fromQuery %></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- logo + user.bio %></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%-notDeclared%></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- unknownName -%></div>
  <% var banner = '<b>x</b>'; %>
  <% banner = req.query.q; %>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- banner %></div>

  <% var crest = "<i>c</i>"; %>
  <p>text between</p>
  <% crest = user.crest; %>
  <p>more text</p>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- crest %></div>

  <% var badge = '<b>1</b>'; %>
  <% badge = '<b>2</b>'; %>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%- badge %></div>
  <% var seal = '<b>s</b>'; %>
  <% seal = req.query.s; %>
  <% seal = '<b>safe again</b>'; %>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%- seal %></div>

  <% var tag = '<b>t</b>'; %>
  <!-- ok: sast.js.ejs-unescaped -->
  <div><%- tag %></div>
  <% tag = req.query.t; %>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- tag %></div>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%-tag-%></div>

  <% let partial = include('partials/a'); %>
  <% partial = user.partial; %>
  <!-- ruleid: sast.js.ejs-unescaped -->
  <div><%- partial %></div>
</body>
</html>
